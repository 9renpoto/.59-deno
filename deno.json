{
  "workspace": [
    "./apps/api"
  ],
  "tasks": {
    "denoflare": "deno run -A --unstable-worker-options https://raw.githubusercontent.com/skymethod/denoflare/v0.7.0/cli/cli.ts",
    "test": "deno test --allow-all",
    "test:coverage": "deno test --allow-all --coverage=coverage && deno coverage coverage --lcov > coverage.lcov",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
